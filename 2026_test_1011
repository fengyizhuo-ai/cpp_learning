#include<iostream>
using namespace std;
int main() 
{   
	int x, y, r1, r2;
	cout << "请输入两整数:";
	cin >> x >> y;
	if (y == 0)
	{
		cout << "input error";
	}
	else
	{
		if (x == 0)
		{
			r1 = 0;r2 = y;
		}
		else
		{
			r1 = x / y;
			r2 = x % y;
		}
		cout << "商=" << r1 << " 余数=" << r2;
	}
	return 0;
}
