#include<iostream>
#include<cmath>
using namespace std;
int main() {
	double a;
	cout << "请输入a：";
	cin >> a;
	double x = a, nx = 0;
	cout << "三次方根：";
	if (a == 0)
		cout << 0;
	else
	{
		nx = (2.0 / 3) * x + a / (3.0 * x * x);
		while (fabs(nx - x) > 0.00001)
		{
			x = nx;
			nx = (2.0 / 3) * x + a / (3.0 * x * x);
		}
		cout << nx;
	}
	return 0;
}
