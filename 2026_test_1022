#include <iostream>
using namespace std;
int main() {
    int a[10];
    int x;
    cout << "请依次输入10个整数（程序会自动降序排列）: ";
    for (int i = 0; i < 10; i++) {
        cin >> a[i];
    }
    for (int i = 0; i < 9; i++) 
    {
        int maxIndex = i;
        for (int j = i + 1; j < 10; j++) 
        {
            if (a[j] > a[maxIndex])
            {
                maxIndex = j;
            }
        }
        swap(a[i], a[maxIndex]);
    }
    cout << "降序排列后的数组: ";
    for (int i = 0; i < 10; i++) 
    {
        cout << a[i] << " ";
    }
    cout << endl;
    cout << "请输入要查找的整数 x: ";
    cin >> x;
    int left = 0;
    int right = 9;
    int pos = -1;
    while (left <= right) 
    {
        int mid = (left + right) / 2;
        if (a[mid] == x) 
        {
            pos = mid;
            break;
        }
        else if (a[mid] > x)
        {
            left = mid + 1;
        }
        else 
        {
            right = mid - 1;
        }
    }
    if (pos != -1) 
    {
        cout << "找到 " << x << "，它在数组中的位置是: 第 " << pos + 1 << " 个（下标为 " << pos << "）" << endl;
    }
    else 
    {
        cout << "数组中不存在 " << x << endl;
    }
    return 0;
}
